@model PulseCareClinic.Models.Appointment

@{
    ViewData["Title"] = "Cancel Appointment #" + Model.Id;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm rounded-4">
            <div class="card-header bg-danger text-white py-3 rounded-top-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Cancel &amp; Delete Appointment</h4>
            </div>
            <div class="card-body p-4">
                <p class="lead text-dark">Are you sure you want to permanently delete this appointment record?</p>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Patient Name:</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Patient?.FullName</dd>

                        <dt class="col-sm-4 text-muted">Doctor:</dt>
                        <dd class="col-sm-8">@Model.Doctor?.FullName</dd>

                        <dt class="col-sm-4 text-muted">Date &amp; Slot:</dt>
                        <dd class="col-sm-8">@Model.AppointmentDate.ToString("dd MMM yyyy") (@Model.TimeSlot)</dd>

                        <dt class="col-sm-4 text-muted">Status:</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Status</span></dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> No, Go Back
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                            <i class="bi bi-trash-fill me-1"></i> Confirm Cancellation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
