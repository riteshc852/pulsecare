@model IEnumerable<PulseCareClinic.Models.Doctor>

@{
    ViewData["Title"] = "Specialist Doctors Directory";
    var departments = ViewBag.Departments as IEnumerable<PulseCareClinic.Models.Department>;
    var selectedDept = ViewBag.SelectedDepartment as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i> Medical Specialists</h2>
        <p class="text-muted mb-0">Browse certified physicians and clinical departments.</p>
    </div>
    <a asp-action="Create" class="btn btn-outline-primary">
        <i class="bi bi-person-plus me-1"></i> Add Doctor (Admin)
    </a>
</div>

<!-- Department Filter Pills -->
<div class="mb-4">
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-sm @(selectedDept == null ? "btn-primary" : "btn-outline-primary") rounded-pill px-3">
            All Departments
        </a>
        @if (departments != null)
        {
            foreach (var dept in departments)
            {
                <a asp-action="Index" asp-route-departmentId="@dept.Id"
                   class="btn btn-sm @(selectedDept == dept.Id ? "btn-primary" : "btn-outline-primary") rounded-pill px-3">
                    @dept.Name
                </a>
            }
        }
    </div>
</div>

<!-- Doctors Responsive Card Grid -->
<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var doctor in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden doctor-card">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
                                <i class="bi bi-person-badge-fill fs-2"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">@doctor.FullName</h5>
                                <span class="badge bg-info bg-opacity-10 text-info fw-semibold">@doctor.Department?.Name</span>
                            </div>
                        </div>

                        <p class="text-muted small mb-3">
                            <i class="bi bi-mortarboard me-1 text-secondary"></i> @doctor.Specialization
                        </p>

                        <div class="bg-light rounded-3 p-3 mb-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted"><i class="bi bi-calendar-week me-1"></i> Available:</span>
                                <span class="fw-semibold text-dark">@doctor.AvailableDays</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted"><i class="bi bi-telephone me-1"></i> Phone:</span>
                                <span class="fw-semibold text-dark">@doctor.PhoneNumber</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-cash me-1"></i> Consultation:</span>
                                <span class="fw-bold text-success fs-6">₹@doctor.ConsultationFee</span>
                            </div>
                        </div>

                        <a asp-controller="Appointments" asp-action="Create" asp-route-selectedDoctorId="@doctor.Id" class="btn btn-primary w-100 rounded-3 fw-semibold">
                            <i class="bi bi-calendar-check me-1"></i> Book Appointment
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
            No doctors found in this department.
        </div>
    }
</div>
