@model PulseCareClinic.ViewModels.AppointmentCreateViewModel

@{
    ViewData["Title"] = "Book New Appointment";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-primary text-white py-3 rounded-top-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-calendar-plus me-2"></i> Book Doctor Appointment</h4>
                <small class="text-white-50">Fill in patient details and select an available doctor consultation slot.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Section 1: Patient Information -->
                    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                        <i class="bi bi-person-fill me-1"></i> Patient Details
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label asp-for="PatientName" class="form-label fw-semibold"></label>
                            <input asp-for="PatientName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="PatientName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PatientEmail" class="form-label fw-semibold"></label>
                            <input asp-for="PatientEmail" class="form-control" placeholder="john.doe@example.com" />
                            <span asp-validation-for="PatientEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PatientPhone" class="form-label fw-semibold"></label>
                            <input asp-for="PatientPhone" class="form-control" placeholder="+91 98765 43210" />
                            <span asp-validation-for="PatientPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Section 2: Consultation Details -->
                    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                        <i class="bi bi-hospital me-1"></i> Consultation &amp; Slot Selection
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label asp-for="DoctorId" class="form-label fw-semibold"></label>
                            <select asp-for="DoctorId" asp-items="Model.DoctorsList" class="form-select">
                                <option value="">-- Choose Specialist Doctor --</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label fw-semibold"></label>
                            <input asp-for="AppointmentDate" type="date" class="form-control" />
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TimeSlot" class="form-label fw-semibold"></label>
                            <select asp-for="TimeSlot" asp-items="Model.TimeSlotsList" class="form-select">
                                <option value="">-- Select Time Slot --</option>
                            </select>
                            <span asp-validation-for="TimeSlot" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="ReasonForVisit" class="form-label fw-semibold"></label>
                            <textarea asp-for="ReasonForVisit" rows="3" class="form-control" placeholder="Describe symptoms or reasons for visit..."></textarea>
                            <span asp-validation-for="ReasonForVisit" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Confirm Booking
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Client-side jQuery Validation scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
