@model PulseCareClinic.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Clinic Operations Dashboard";
}

<!-- Hero Section -->
<div class="p-4 p-md-5 mb-4 rounded-4 bg-primary bg-gradient text-white shadow-sm">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold mb-3"><i class="bi bi-hospital"></i> Smart Healthcare &amp; Clinic Portal</h1>
            <p class="lead mb-4">Digitizing doctor schedules, patient appointments, and clinic operations with ASP.NET Core MVC and MySQL.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-warning btn-lg fw-semibold px-4 shadow">
                    <i class="bi bi-calendar-plus me-1"></i> Book Appointment Now
                </a>
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-search me-1"></i> Browse Doctors
                </a>
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="bi bi-shield-check text-light opacity-50" style="font-size: 8rem;"></i>
        </div>
    </div>
</div>

<!-- Metrics Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-semibold">Total Appointments</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalAppointments</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-calendar-event fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-semibold">Pending Review</h6>
                    <h3 class="fw-bold mb-0 text-warning">@Model.PendingAppointments</h3>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-semibold">Confirmed Slots</h6>
                    <h3 class="fw-bold mb-0 text-success">@Model.ConfirmedAppointments</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-check-all fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-semibold">Active Doctors</h6>
                    <h3 class="fw-bold mb-0 text-info">@Model.TotalDoctors</h3>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-person-heart fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Appointments Column -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i> Recent Appointments</h5>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th>Ref #</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date &amp; Slot</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentAppointments.Any())
                            {
                                foreach (var appt in Model.RecentAppointments)
                                {
                                    <tr>
                                        <td class="fw-bold text-muted">#@appt.Id</td>
                                        <td>
                                            <div class="fw-semibold">@appt.Patient?.FullName</div>
                                            <small class="text-muted">@appt.Patient?.PhoneNumber</small>
                                        </td>
                                        <td>
                                            <div>@appt.Doctor?.FullName</div>
                                            <small class="text-muted">@appt.Doctor?.Department?.Name</small>
                                        </td>
                                        <td>
                                            <span class="d-block fw-semibold">@appt.AppointmentDate.ToString("dd MMM yyyy")</span>
                                            <small class="text-muted">@appt.TimeSlot</small>
                                        </td>
                                        <td>
                                            @switch (appt.Status)
                                            {
                                                case PulseCareClinic.Models.AppointmentStatus.Pending:
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                    break;
                                                case PulseCareClinic.Models.AppointmentStatus.Confirmed:
                                                    <span class="badge bg-success">Confirmed</span>
                                                    break;
                                                case PulseCareClinic.Models.AppointmentStatus.Completed:
                                                    <span class="badge bg-secondary">Completed</span>
                                                    break;
                                                case PulseCareClinic.Models.AppointmentStatus.Cancelled:
                                                    <span class="badge bg-danger">Cancelled</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No appointments recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Doctors Column -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-badge me-2 text-primary"></i> Available Specialists</h5>
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-sm btn-outline-primary">View Directory</a>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (var doc in Model.FeaturedDoctors)
                    {
                        <div class="list-group-item border-0 px-0 py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-0">@doc.FullName</h6>
                                <small class="text-muted d-block">@doc.Specialization &middot; <span class="text-primary">@doc.Department?.Name</span></small>
                                <small class="text-success fw-semibold"><i class="bi bi-currency-rupee"></i>@doc.ConsultationFee &middot; @doc.AvailableDays</small>
                            </div>
                            <a asp-controller="Appointments" asp-action="Create" asp-route-selectedDoctorId="@doc.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                Book
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
