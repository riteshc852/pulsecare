@model IEnumerable<PulseCareClinic.Models.Appointment>

@{
    ViewData["Title"] = "Manage Appointments";
    var currentFilter = ViewBag.CurrentFilter as string;
    var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar2-check text-primary me-2"></i> Clinic Appointments</h2>
        <p class="text-muted mb-0">Search, filter, update, or cancel registered appointments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> New Appointment
    </a>
</div>

<!-- Search & Status Filter Form -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchString" value="@currentSearch" class="form-control border-start-0" placeholder="Search by patient, doctor, or symptoms..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="statusFilter" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Pending" selected="@(currentFilter == "Pending")">Pending</option>
                    <option value="Confirmed" selected="@(currentFilter == "Confirmed")">Confirmed</option>
                    <option value="Completed" selected="@(currentFilter == "Completed")">Completed</option>
                    <option value="Cancelled" selected="@(currentFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Appointments Table (CRUD Read) -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small">
                <tr>
                    <th>Ref #</th>
                    <th>Patient Info</th>
                    <th>Doctor &amp; Department</th>
                    <th>Scheduled Slot</th>
                    <th>Reason / Symptoms</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@item.Id</td>
                            <td>
                                <div class="fw-semibold">@item.Patient?.FullName</div>
                                <small class="text-muted">@item.Patient?.PhoneNumber</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Doctor?.FullName</div>
                                <small class="text-primary">@item.Doctor?.Department?.Name</small>
                            </td>
                            <td>
                                <div>@item.AppointmentDate.ToString("ddd, dd MMM yyyy")</div>
                                <small class="badge bg-light text-dark border">@item.TimeSlot</small>
                            </td>
                            <td>
                                <span class="d-inline-block text-truncate" style="max-width: 180px;" title="@item.ReasonForVisit">
                                    @item.ReasonForVisit
                                </span>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case PulseCareClinic.Models.AppointmentStatus.Pending:
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Pending</span>
                                        break;
                                    case PulseCareClinic.Models.AppointmentStatus.Confirmed:
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Confirmed</span>
                                        break;
                                    case PulseCareClinic.Models.AppointmentStatus.Completed:
                                        <span class="badge bg-secondary"><i class="bi bi-flag me-1"></i> Completed</span>
                                        break;
                                    case PulseCareClinic.Models.AppointmentStatus.Cancelled:
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Cancelled</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Edit / Update">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Cancel & Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No appointment records match your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
